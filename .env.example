# Copy this file to .env and fill in your Kalshi API key (optional; raises the Kalshi rate limit).
# Key ID is shown on kalshi.com > Account & security > API Keys when you create the key.
KALSHI_API_KEY_ID=
# Path to the downloaded private key file (absolute, or relative to this folder).
KALSHI_PRIVATE_KEY_PATH=kalshi.key
# Or, instead of a file, the key itself (PEM text; line breaks may be written as \n):
# KALSHI_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Polymarket US API key (needed only for the Make trade button). Create it at polymarket.us/developer.
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=

# Optional phone alerts for new arbs (see "Alerts" in the README). Discord and/or Telegram.
# DISCORD_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ALERT_MIN_PROFIT=5
# ALERT_COOLDOWN_MINS=30

# Dashboard on your phone: once this is set, start-dashboard.bat also serves it on your Wi-Fi.
# Other devices must log in with this password (at least 8 characters).
# DASHBOARD_PASSWORD=
