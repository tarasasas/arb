# Copy this file to .env and fill in your Kalshi API key (optional; raises the Kalshi rate limit).
# Key ID is shown on kalshi.com > Account & security > API Keys when you create the key.
KALSHI_API_KEY_ID=
# Path to the downloaded private key file (absolute, or relative to this folder).
KALSHI_PRIVATE_KEY_PATH=kalshi.key

# Polymarket US API key (needed only for the Make trade button). Create it at polymarket.us/developer.
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=
